{
  "description": "Run an arbitrary shell command",
  "params": {
    "type": "object",
    "required": ["cmd"],
    "properties": {
      "cmd": {
        "type": "string",
        "description": "Command to execute",
        "contentMediaType": "text/x-sh"
      },
      "dir": {
        "type": "string",
        "description": "Working directory",
        "default": ""
      }
    }
  },
  "start": {
    "command": "cd \"${DIR:-.}\" && sh \"${CMD_FILE}\""
  }
}
