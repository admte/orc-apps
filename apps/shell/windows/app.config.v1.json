{
  "description": "Run an arbitrary shell command",
  "params": {
    "type": "object",
    "required": ["cmd"],
    "properties": {
      "cmd": {
        "type": "string",
        "description": "Command to execute (cmd.exe syntax)",
        "contentMediaType": "text/plain"
      },
      "dir": {
        "type": "string",
        "description": "Working directory",
        "default": ""
      }
    }
  },
  "start": {
    "command": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"if ($env:DIR) { Set-Location -LiteralPath $env:DIR }; cmd.exe /c (Get-Content -Raw -LiteralPath $env:CMD_FILE)\""
  }
}
